{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "jsxSingleQuote": false,
  "printWidth": 80,
  "sortPackageJson": false,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css"
  },
  "ignorePatterns": ["dist", ".next", "next-env.d.ts", "pnpm-lock.yaml"]
}
